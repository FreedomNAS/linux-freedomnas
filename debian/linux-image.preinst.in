#!/bin/sh
set -e

version=@KREL@
image_path=/boot/vmlinuz-$version

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    if [ -d /etc/kernel/preinst.d ]; then
        DEB_MAINT_PARAMS="$*" run-parts --report --exit-on-error --arg="$version" \
            --arg="$image_path" /etc/kernel/preinst.d
    fi
fi

#DEBHELPER#

exit 0
